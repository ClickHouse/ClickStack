{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../oxlint/base.jsonc"],
  "jsPlugins": ["eslint-plugin-simple-import-sort"],
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "Buffer": "readonly",
    "URL": "readonly"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "**/*.config.mjs",
    "**/*.config.js",
    "jest.config.js",
    "scripts/viewer/**"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Import from 'zod/v3'. Bare 'zod' is the v4 API; mixing v3 and v4 schemas breaks composition and ZodError checks."
          },
          {
            "name": "zod/v4",
            "message": "Import from 'zod/v3' until the codebase migrates to v4."
          },
          {
            "name": "zod/mini",
            "message": "Import from 'zod/v3' until the codebase migrates to v4."
          }
        ]
      }
    ],
    "simple-import-sort/imports": "error",
    "simple-import-sort/exports": "error"
  }
}
