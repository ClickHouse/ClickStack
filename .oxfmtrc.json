{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "proseWrap": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    ".volumes",
    "packages/api/openapi.json"
  ]
}
